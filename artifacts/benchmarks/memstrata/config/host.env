# Single source of truth for host-side paths and defaults.
# Source this file from every shell helper and read it from mimebench.py.
# Override any value by setting the env var before invoking the runner.

# tacc_stats / HPCPerfStats binary + log directories.
: "${TACC_STATS_DIR:=/users/dhkim/HPCPerfStats/monitor/src}"
: "${TACC_STATS_LOG_PATH:=/var/log/hpcperfstats}"

# virtiofs share mounted into every VM as /home/ubuntu/shared.
: "${SHARED_DIR:=/dev/shm/shared}"

# Default sampling interval (seconds) for hpcperfstatsd + powercap loops.
: "${SAMPLE_INTERVAL_SEC:=1}"

# Default output root for run results.
: "${DATA_DIR:=data}"

# Path to the workload registry (TSV: name<TAB>type<TAB>install_stack).
: "${WORKLOAD_REGISTRY:=$(dirname "${BASH_SOURCE[0]}")/workloads.tsv}"

# Default VM pool per workload type.  Used to pick a free VM when scheduling a
# target app alongside an existing mix.  Format: TYPE:vm_id,vm_id,...
# (kept here so mimebench.py and shell scripts agree.)
: "${VM_POOL_WEBSERVER:=1,2}"
: "${VM_POOL_DEATHSTARBENCH:=3}"
: "${VM_POOL_BIGDATA:=4,5}"
: "${VM_POOL_DATABASE:=6}"
: "${VM_POOL_KVSTORE:=7,8}"
: "${VM_POOL_ML:=9}"
: "${VM_POOL_GRAPH:=10}"
: "${VM_POOL_SPEC:=4,5}"

# Maximum total vCPUs across all co-running VMs (host pinning budget).
: "${MAX_CPU_CORES:=20}"

# SSH options used everywhere.
: "${SSH_OPTS:=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR}"

export TACC_STATS_DIR TACC_STATS_LOG_PATH SHARED_DIR SAMPLE_INTERVAL_SEC \
       DATA_DIR WORKLOAD_REGISTRY MAX_CPU_CORES SSH_OPTS \
       VM_POOL_WEBSERVER VM_POOL_DEATHSTARBENCH VM_POOL_BIGDATA \
       VM_POOL_DATABASE VM_POOL_KVSTORE VM_POOL_ML VM_POOL_GRAPH VM_POOL_SPEC
